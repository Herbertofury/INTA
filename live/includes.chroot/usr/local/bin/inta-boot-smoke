#!/bin/sh
set -eu
[ "$(cat /sys/class/dmi/id/product_serial 2>/dev/null || true)" = INTA_CI_SMOKE ] || exit 0
exec >/dev/ttyS0 2>&1
finish() {
    status=$?
    trap - EXIT
    if [ "$status" -eq 0 ]; then
        printf '\nINTA_SMOKE_PASS\n'
    else
        printf '\nINTA_SMOKE_FAIL (%s)\n' "$status"
        systemctl --no-pager status lightdm live-config || true
        journalctl --no-pager -b -u lightdm -u live-config -n 80 || true
    fi
    systemctl poweroff --no-block || true
    exit "$status"
}
trap finish EXIT
printf '\nINTA_SMOKE_START\n'
for attempt in $(seq 1 90); do
    if pgrep -u inta -x xfce4-session >/dev/null 2>&1 &&
       pgrep -u inta -f '/usr/local/bin/inta-rescue' >/dev/null 2>&1; then
        runuser -u inta -- env HOME=/home/inta /usr/local/bin/inta-self-test
        exit 0
    fi
    sleep 2
done
exit 1
