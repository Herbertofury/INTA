#!/bin/bash
set -euo pipefail
iso=$(realpath -- "$1")
if [[ ! -f "$iso" || ! -s "$iso" ]]; then
    printf 'Expected a nonempty rescue ISO file: %s\n' "$iso" >&2
    exit 2
fi
mode=$2
diagnostics=$(realpath -m "${3:-dist/boot-diagnostics}")
mkdir -p "$diagnostics"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
log="$diagnostics/$mode-serial.log"
args=()
case "$mode" in
    bios) ;;
    uefi)
        firmware=/usr/share/OVMF
        vars="$work/vars.fd"
        cp "$firmware/OVMF_VARS_4M.fd" "$vars"
        args=(-drive "if=pflash,unit=0,format=raw,readonly=on,file=$firmware/OVMF_CODE_4M.fd"
              -drive "if=pflash,unit=1,format=raw,file=$vars")
        ;;
    *) exit 2 ;;
esac
acceleration=tcg
cpu=max
if [[ -r /dev/kvm && -w /dev/kvm ]]; then
    acceleration=kvm
    cpu=host
fi
# The gate reads only this invocation's serial stream, even if an
# output directory is reused. Export for diagnostics without following symlinks.
guest_log="$work/serial.log"
: > "$guest_log"
publish_serial() {
    local fresh_log
    fresh_log=$(mktemp -- "$diagnostics/.$mode-serial.XXXXXXXX") || return 1
    if ! cp -- "$guest_log" "$fresh_log" || ! mv -fT -- "$fresh_log" "$log"; then
        rm -f -- "$fresh_log"
        return 1
    fi
}
publish_serial
printf 'Booting INTA via %s (%s)\n' "$mode" "$acceleration"
qemu-system-x86_64 -machine "q35,accel=$acceleration" -cpu "$cpu" -smp 2 -m 3072 \
    -nic none -display none -monitor "unix:$work/monitor,server=on,wait=off" \
    -serial "file:$guest_log" -boot order=d,strict=on \
    -smbios type=1,serial=INTA_CI_SMOKE -cdrom "$iso" "${args[@]}" &
guest=$!
trap 'kill "$guest" 2>/dev/null || true; rm -rf "$work"' EXIT
for ((second = 0; second < 340; second += 5)); do
    if ! kill -0 "$guest" 2>/dev/null; then
        rc=0
        wait "$guest" || rc=$?
        publish_serial
        tail -c 262144 -- "$guest_log"
        if ((rc != 0)); then
            printf 'QEMU exited with status %s during %s boot.\n' "$rc" "$mode" >&2
            exit "$rc"
        fi
        python3 "$(dirname -- "$0")/rescue_boot_log.py" "$guest_log"
        exit
    fi
    if ((second == 35)); then
        # Debian's live menu waits for input. Select its default entry once;
        # desktop readiness and clean guest shutdown are still required below.
        printf 'Selecting the default %s live boot entry.\n' "$mode"
        python3 - "$work/monitor" <<'PY_SELECT_BOOT'
import socket
import sys

with socket.socket(socket.AF_UNIX) as monitor:
    monitor.settimeout(3)
    monitor.connect(sys.argv[1])

    def prompt():
        response = bytearray()
        while b"(qemu)" not in response:
            part = monitor.recv(4096)
            if not part:
                raise RuntimeError("QEMU monitor closed before acknowledging boot selection")
            response.extend(part)
        return bytes(response)

    prompt()
    monitor.sendall(b"sendkey ret\n")
    response = prompt()
    if any(word in response.lower() for word in (b"error", b"unknown", b"invalid")):
        raise RuntimeError("QEMU rejected the default boot selection: " + response.decode(errors="replace"))
PY_SELECT_BOOT
    fi
    if ((second == 35 || second == 175 || second == 325)); then
        python3 - "$work/monitor" "$diagnostics/$mode-$second.ppm" <<'PY' || true
import pathlib
import socket
import sys
import time

target = pathlib.Path(sys.argv[2])
with socket.socket(socket.AF_UNIX) as monitor:
    monitor.settimeout(3)
    monitor.connect(sys.argv[1])
    monitor.recv(4096)
    monitor.sendall(f"screendump {target}\n".encode())
    for attempt in range(10):
        if target.exists():
            break
        time.sleep(0.1)
PY
    fi
    sleep 5
done
publish_serial
tail -c 262144 -- "$guest_log"
printf 'Timed out waiting for %s guest to report desktop readiness.\n' "$mode" >&2
exit 1
