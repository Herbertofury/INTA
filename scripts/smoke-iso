#!/bin/bash
set -euo pipefail
iso=$(realpath "$1")
mode=$2
diagnostics=$(realpath -m "${3:-dist/boot-diagnostics}")
mkdir -p "$diagnostics"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
log="$diagnostics/$mode-serial.log"
args=()
case "$mode" in
    bios) ;;
    uefi)
        firmware=/usr/share/OVMF
        vars="$work/vars.fd"
        cp "$firmware/OVMF_VARS_4M.fd" "$vars"
        args=(-drive "if=pflash,unit=0,format=raw,readonly=on,file=$firmware/OVMF_CODE_4M.fd"
              -drive "if=pflash,unit=1,format=raw,file=$vars")
        ;;
    *) exit 2 ;;
esac
acceleration=tcg
cpu=max
if [[ -r /dev/kvm && -w /dev/kvm ]]; then
    acceleration=kvm
    cpu=host
fi
printf 'Booting INTA via %s (%s)\n' "$mode" "$acceleration"
qemu-system-x86_64 -machine "q35,accel=$acceleration" -cpu "$cpu" -smp 2 -m 3072 \
    -nic none -display none -monitor "unix:$work/monitor,server=on,wait=off" \
    -serial "file:$log" -boot order=d,strict=on \
    -smbios type=1,serial=INTA_CI_SMOKE -cdrom "$iso" "${args[@]}" &
guest=$!
trap 'kill "$guest" 2>/dev/null || true; rm -rf "$work"' EXIT
for ((second = 0; second < 340; second += 5)); do
    if ! kill -0 "$guest" 2>/dev/null; then
        wait "$guest"
        cat "$log"
        tr -d '\r' < "$log" | grep -Fx INTA_SMOKE_PASS
        exit
    fi
    if ((second == 35 || second == 175 || second == 325)); then
        python3 - "$work/monitor" "$diagnostics/$mode-$second.ppm" <<'PY' || true
import pathlib
import socket
import sys
import time

target = pathlib.Path(sys.argv[2])
with socket.socket(socket.AF_UNIX) as monitor:
    monitor.settimeout(3)
    monitor.connect(sys.argv[1])
    monitor.recv(4096)
    monitor.sendall(f"screendump {target}\n".encode())
    for attempt in range(10):
        if target.exists():
            break
        time.sleep(0.1)
PY
    fi
    sleep 5
done
cat "$log"
printf 'Timed out waiting for %s guest to report desktop readiness.\n' "$mode" >&2
exit 1
