<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="INTA Desktop"
 Width="1150" Height="760" MinWidth="690" MinHeight="480" WindowStartupLocation="CenterScreen"
 UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#17191B"/>
  <SolidColorBrush x:Key="Rail" Color="#111314"/>
  <SolidColorBrush x:Key="Surface" Color="#222529"/>
  <SolidColorBrush x:Key="Hover" Color="#30353A"/>
  <SolidColorBrush x:Key="Select" Color="#23384E"/>
  <SolidColorBrush x:Key="Border" Color="#35393E"/>
  <SolidColorBrush x:Key="Muted" Color="#B0B7BE"/>
  <SolidColorBrush x:Key="Text" Color="#F1F3F5"/>
  <SolidColorBrush x:Key="Accent" Color="#8FC4FF"/>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource Rail}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
     <Track.DecreaseRepeatButton><RepeatButton Focusable="False" Opacity="0" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Border Margin="3,1" Background="{DynamicResource Muted}" CornerRadius="3" Opacity=".62"/>
     </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Focusable="False" Opacity="0" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
    </Track></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="12,7"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Select}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value=".55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,0,1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Item" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Stretch"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Select}"/><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
   <Setter Property="Padding" Value="9,5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="EntryTemplate"><StackPanel>
   <ContentPresenter Content="{Binding DisplayTitle}"/>
   <ContentPresenter Content="{Binding DisplaySubtitle}" Margin="0,3,0,0"/>
   <WrapPanel Visibility="{Binding ToolControls}" Margin="0,5,0,0">
    <Button Content="Install options" Tag="install" AutomationProperties.Name="{Binding InstallName}" ToolTip="Review installation options" Padding="7,2" Margin="0,0,5,0" FontSize="12"/>
    <Button Content="Launch options" Tag="launch" AutomationProperties.Name="{Binding LaunchName}" ToolTip="Review launch options" Padding="7,2" FontSize="12"/>
   </WrapPanel>
  </StackPanel></DataTemplate>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
    <DockPanel LastChildFill="True" Margin="10,0">
     <StackPanel DockPanel.Dock="Top" Margin="12,21,0,20">
      <TextBlock Text="INTA Desktop" FontSize="22" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="1,10,1,14">
      <Button x:Name="Restart" Content="Open updated version" Visibility="Collapsed" Margin="0,0,0,6"/>
      <Button x:Name="Hub" Content="Open offline hub" Margin="0,0,0,6"/>
      <Button x:Name="Appearance" Content="Appearance Studio" Margin="0,0,0,6"/>
      <Button x:Name="Theme" Content="Use light theme"/>
     </StackPanel>
     <ListBox x:Name="Navigation" AutomationProperties.Name="Workspace navigation">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="OpticalBackground" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="21,14">
     <DockPanel><Button x:Name="Clear" Content="Clear" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4"/>
      <TextBlock Text="Search" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="Search" AutomationProperties.Name="Search all tools, playbooks and methods" ToolTip="Search all tools, playbooks and methods (Ctrl+K)" MaxLength="512"/>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="21,16,18,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel><TextBlock x:Name="Count" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
      <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="24" TextWrapping="Wrap"/></DockPanel>
     <WrapPanel x:Name="PageActions" Grid.Row="1" Margin="0,6,0,8"/>
     <Grid Grid.Row="2" x:Name="Body"><Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ListColumn" Width="2*"/><ColumnDefinition x:Name="GapColumn" Width="16"/><ColumnDefinition x:Name="DetailColumn" Width="3*"/>
     </Grid.ColumnDefinitions>
      <Border x:Name="EntryBorder" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
       <ListBox x:Name="Entries" ItemTemplate="{StaticResource EntryTemplate}" AutomationProperties.Name="Workspace results"/>
      </Border>
      <Grid x:Name="DetailGrid" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <WrapPanel x:Name="DetailActions"/>
       <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Record details">
        <StackPanel x:Name="Detail" Margin="2,2,10,8"/>
       </ScrollViewer>
      </Grid>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="15,5">
   <DockPanel><TextBlock Text="Ctrl+K   Search" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,0,0,0"/>
    <TextBlock x:Name="Status" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel>
  </Border>
 </Grid>
</Window>
